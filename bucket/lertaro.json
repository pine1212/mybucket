{
    "version": "5.12.1",
    "description": "A modern, high-performance local file search and productivity tool for Windows. A sleek, customizable alternative to Everything and Listary built with C# WPF and NT Services, featuring instant NTFS MFT parsing, real-time USN monitoring, and plugin support.",
    "homepage": "https://github.com/Lertaro/Lertaro",
    "license": {
        "identifier": "MIT license",
        "url": "https://github.com/Lertaro/Lertaro#MIT-1-ov-file"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/Lertaro/Lertaro/releases/download/v5.12.1/Lertaro-Setup.exe",
            "hash": "06199142e2b9fcafaa5a6b5de489c48be00070538f3d0f70386f89d592163d13"
        },
        "arm64": {
            "url": "https://github.com/Lertaro/Lertaro/releases/download/v5.12.1/Lertaro-Setup-arm64.exe",
            "hash": "1e1dffa2ab1d538a1d0453a653f166ba854c2c6696d7c8c83562c242b0eddd9d"
        }
    },
    "innosetup": true,
    "bin": [
        [
            "Lertaro.App.exe",
            "Lertaro"
        ]
    ],
    "shortcuts": [
        [
            "Lertaro.App.exe",
            "Lertaro"
        ]
    ],
    "post_install": [
        "$target = $original_dir",
        "$updater = Join-Path $target 'portable-updater.ps1'",
        "$current = Split-Path $target -Leaf",
        "$versions = @(Get-ChildItem -LiteralPath (Split-Path $target) -Directory -Force -ErrorAction Ignore | Where-Object { $parsed = $null; ($_.Name -ne $current) -and [System.Version]::TryParse($_.Name, [ref]$parsed) -and (Test-Path -LiteralPath (Join-Path $_.FullName 'portable-updater.ps1') -PathType Leaf) })",
        "$previous = $null",
        "if ($versions.Count -gt 0) { $previous = ($versions | Sort-Object -Property { [System.Version]$_.Name } -Descending | Select-Object -First 1).FullName }",
        "if ($previous) {",
        "    Write-Host \"lertaro: migrating the previous installation ($(Split-Path $previous -Leaf)) into this version.\"",
        "    $reserved = 'Data', 'update-payload', 'update.lock', 'update-result.json', '.permissions-version'",
        "    $extras = @(Get-ChildItem -LiteralPath $previous -Recurse -File -Force -ErrorAction Ignore | Where-Object { $relative = $_.FullName.Substring($previous.Length + 1); $head = $relative.Split([System.IO.Path]::DirectorySeparatorChar)[0]; ($reserved -notcontains $head) -and (($_.Attributes -band [System.IO.FileAttributes]::ReparsePoint) -eq 0) -and !(Test-Path -LiteralPath (Join-Path $target $relative) -PathType Leaf) })",
        "    $stage = $null",
        "    if ($extras.Count -gt 0) {",
        "        $stage = Join-Path (Join-Path $target 'update-payload') ('migrate-' + [System.Guid]::NewGuid().ToString('N'))",
        "        foreach ($file in $extras) { $destination = Join-Path $stage $file.FullName.Substring($previous.Length + 1); New-Item -ItemType Directory -Force -Path (Split-Path $destination) | Out-Null; Copy-Item -LiteralPath $file.FullName -Destination $destination -Force }",
        "    }",
        "    $worker = Join-Path ([System.IO.Path]::GetTempPath()) ('lertaro-migrate-' + [System.Guid]::NewGuid().ToString('N') + '.ps1')",
        "    $report = Join-Path ([System.IO.Path]::GetTempPath()) ('lertaro-migrate-' + [System.Guid]::NewGuid().ToString('N') + '.json')",
        "@'",
        "param([string]$Previous, [string]$Target, [string]$Stage, [string]$Updater, [string]$Report)",
        "$summary = @{ Data = -1; Errors = @() }",
        "# The service owns the index files in Data while it runs, and the folder is locked down against",
        "# ordinary rights, so everything below has to happen elevated.",
        "$stopped = $false",
        "if (((@(& sc.exe query LertaroService 2>$null)) -join ' ') -match 'STATE') {",
        "    & sc.exe stop LertaroService | Out-Null",
        "    $deadline = [System.Diagnostics.Stopwatch]::StartNew()",
        "    while ($deadline.Elapsed.TotalSeconds -lt 30) {",
        "        $state = (@(& sc.exe query LertaroService 2>$null)) -join ' '",
        "        if ($state -match 'STOPPED' -or $state -match '1060') { break }",
        "        Start-Sleep -Milliseconds 200",
        "    }",
        "    $stopped = $true",
        "}",
        "$source = Join-Path $Previous 'Data'",
        "if (Test-Path -LiteralPath $source) {",
        "    $lines = @((& robocopy $source (Join-Path $Target 'Data') /E /XO /COPY:DAT /R:2 /W:1 /FP /NJH /NJS /NP 2>&1) | ForEach-Object { $_.ToString() })",
        "    $summary.Data = $LASTEXITCODE",
        "    $summary.Errors = @($lines | Select-String -SimpleMatch 'ERROR' | ForEach-Object { $_.Line } | Select-Object -First 20)",
        "}",
        "if ($Stage -and (Test-Path -LiteralPath $Stage)) {",
        "    Remove-Item -LiteralPath (Join-Path $Target 'update-result.json') -Force -ErrorAction Ignore",
        "    & $Updater -Source $Stage -Destination $Target",
        "} elseif ($stopped) {",
        "    & sc.exe start LertaroService | Out-Null",
        "}",
        "$summary | ConvertTo-Json -Depth 3 | Set-Content -LiteralPath $Report -Encoding ASCII",
        "'@ | Set-Content -LiteralPath $worker -Encoding ASCII",
        "    $powerShell = Join-Path ([System.Environment]::GetFolderPath('System')) (Join-Path 'WindowsPowerShell' (Join-Path 'v1.0' 'powershell.exe'))",
        "    $elevated = (New-Object System.Security.Principal.WindowsPrincipal([System.Security.Principal.WindowsIdentity]::GetCurrent())).IsInRole([System.Security.Principal.WindowsBuiltInRole]::Administrator)",
        "    $stageText = if ($stage) { $stage } else { '' }",
        "    $arguments = @('-NoLogo', '-NoProfile', '-NonInteractive', '-ExecutionPolicy', 'Bypass', '-File', $worker, '-Previous', $previous, '-Target', $target, '-Stage', $stageText, '-Updater', $updater, '-Report', $report)",
        "    try { if ($elevated) { Start-Process -FilePath $powerShell -ArgumentList $arguments -Wait -NoNewWindow -ErrorAction Stop } else { Start-Process -FilePath $powerShell -ArgumentList $arguments -Verb RunAs -Wait -ErrorAction Stop } } catch { Write-Host \"lertaro: the migration needs administrator approval and was skipped: $($_.Exception.Message)\" -ForegroundColor Yellow }",
        "    if (Test-Path -LiteralPath $report) {",
        "        $summary = Get-Content -LiteralPath $report -Raw | ConvertFrom-Json",
        "        if ($summary.Data -gt 7) { Write-Host 'lertaro: part of the data could not be copied:' -ForegroundColor Yellow; $summary.Errors | ForEach-Object { Write-Host \"  $_\" -ForegroundColor Yellow } }",
        "    } else { Write-Host 'lertaro: the migration did not run, the previous data was left untouched.' -ForegroundColor Yellow }",
        "    if ($stage -and (Test-Path -LiteralPath (Join-Path $target 'update-result.json'))) { $result = Get-Content -LiteralPath (Join-Path $target 'update-result.json') -Raw | ConvertFrom-Json; if ($result.Status -ne 'success') { Write-Host \"lertaro: the updater reported: $($result.Message)\" -ForegroundColor Yellow } }",
        "    Remove-Item -LiteralPath $worker, $report -Force -ErrorAction Ignore",
        "    if ($stage -and (Test-Path -LiteralPath $stage)) { try { [System.IO.Directory]::Delete($stage, $true) } catch { Write-Host \"lertaro: the staging folder $stage could not be removed.\" -ForegroundColor Yellow } }",
        "    $payload = Join-Path $target 'update-payload'",
        "    if ((Test-Path -LiteralPath $payload) -and !(Get-ChildItem -LiteralPath $payload -Force)) { try { [System.IO.Directory]::Delete($payload, $true) } catch { } }",
        "} else { Write-Host 'lertaro: no previous installation to migrate.' }",
        "$executable = Join-Path $target 'Lertaro.App.exe'",
        "if (Test-Path -LiteralPath $executable -PathType Leaf) {",
        "    $startMenu = 'StartMenu'",
        "    if ($global) { $startMenu = 'CommonStartMenu' }",
        "    $shortcut = Join-Path ([System.Environment]::GetFolderPath($startMenu)) (Join-Path 'Programs' (Join-Path 'Scoop Apps' 'Lertaro.lnk'))",
        "    New-Item -ItemType Directory -Force -Path (Split-Path $shortcut) | Out-Null",
        "    $link = (New-Object -ComObject WScript.Shell).CreateShortcut($shortcut)",
        "    $link.TargetPath = $executable",
        "    $link.WorkingDirectory = $target",
        "    $link.IconLocation = \"$executable,0\"",
        "    $link.Save()",
        "    Write-Host \"lertaro: shortcut points to $executable\"",
        "}"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Lertaro/Lertaro/releases/download/v$version/Lertaro-Setup.exe"
            },
            "arm64": {
                "url": "https://github.com/Lertaro/Lertaro/releases/download/v$version/Lertaro-Setup-arm64.exe"
            }
        }
    }
}
